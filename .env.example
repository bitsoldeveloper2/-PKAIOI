# --- Database -------------------------------------------------------------
# SQLite for local development. For production, switch the Prisma datasource
# provider to "postgresql", install @prisma/adapter-pg, and point this at Postgres.
DATABASE_URL="file:./dev.db"

# --- Sessions -------------------------------------------------------------
# 48+ random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI (Claude) ----------------------------------------------------------
# Leave empty to run the platform without AI features; the tutor and lab
# degrade gracefully and explain that AI is not configured.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Seed accounts (development only) ------------------------------------
SEED_PASSWORD="Campus!2026"

# --- Testing ---------------------------------------------------------------
# Multiplies every rate limit (sign-in, forms, AI, search). Keep at 1 in production;
# raise it only when running the end-to-end suite repeatedly against one server.
RATE_LIMIT_SCALE=1
