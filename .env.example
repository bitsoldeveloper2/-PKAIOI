# --- Database -------------------------------------------------------------
# SQLite for local development. In production leave it unset: the app then uses
# file:<home directory>/pioai-data/pioai.db, a folder that survives redeploys.
DATABASE_URL="file:./dev.db"

# --- Sessions -------------------------------------------------------------
# 48+ random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production this may be left unset: a secret is generated once and stored
# beside the database.
SESSION_SECRET=""

# --- Site -----------------------------------------------------------------
# Production builds default to https://pioai.org when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI (Claude) ----------------------------------------------------------
# Leave empty to run the platform without AI features; the tutor and lab
# degrade gracefully and explain that AI is not configured.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Seed accounts --------------------------------------------------------
# In production leave it unset: the first build generates a password, saves it
# to seed-password.txt beside the database and prints it once in the build log.
SEED_PASSWORD="Campus!2026"

# --- Testing ---------------------------------------------------------------
# Multiplies every rate limit (sign-in, forms, AI, search). Keep at 1 in production;
# raise it only when running the end-to-end suite repeatedly against one server.
RATE_LIMIT_SCALE=1
